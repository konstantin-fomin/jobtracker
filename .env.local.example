NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Local UI testing only. Works only in development and never enables mock jobs in production.
# NEXT_PUBLIC_DEMO_JOBS=true

# Optional, local-only (Windows). When set to 1, the production build writes to
# `.next-build` instead of `.next` so it doesn't collide with a running `next dev`.
# Do NOT set this in production — Vercel expects the default `.next` output.
# NEXT_LOCAL_DIST_DIR=1
